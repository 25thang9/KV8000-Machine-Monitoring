# ==========================================================
# KV8000 MACHINE MONITORING - PRODUCTION TEMPLATE
# Không commit file .env thật lên Git.
# ==========================================================

APP_ENV=production

# Django
DJANGO_SECRET_KEY=replace_with_a_long_random_secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.0.20
DJANGO_CSRF_TRUSTED_ORIGINS=
MONITOR_REQUIRE_LOGIN=True

# Chỉ bật các cờ HTTPS khi công ty đã đặt TLS/reverse proxy.
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# ==========================================================
# DATABASE
# Production: postgresql hoặc sqlserver
# sqlite chỉ dùng test/CI.
# ==========================================================
DB_ENGINE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=machine_monitor_db
DB_USER=machine_monitor_user
DB_PASSWORD=replace_with_database_password
DB_CONN_MAX_AGE=60

# SQL Server 2019 - chỉ dùng khi DB_ENGINE=sqlserver
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=

# ==========================================================
# WEBSITE
# ==========================================================
WEB_HOST=0.0.0.0
WEB_PORT=8001

# ==========================================================
# COLLECTOR
# PLC host/port KHÔNG còn đặt tại .env.
# Nhiều PLC/máy được cấu hình trong database qua Django Admin.
# ==========================================================
MONITOR_STALE_AFTER_SECONDS=15
COLLECTOR_CONFIG_REFRESH_SECONDS=5
COLLECTOR_MAX_WORKERS=16
COLLECTOR_RETENTION_DAYS=90
COLLECTOR_LOG_LEVEL=INFO
