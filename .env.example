# ==========================================================
# KV8000 MACHINE MONITORING - CONFIGURATION TEMPLATE
# File mẫu, không chứa mật khẩu thật
# ==========================================================

APP_ENV=development

# Django
DJANGO_SECRET_KEY=replace_with_generated_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database
# Máy lập trình: postgresql
# Máy công ty: sqlserver
DB_ENGINE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=machine_monitor_db
DB_USER=machine_monitor_user
DB_PASSWORD=replace_with_database_password

# SQL Server 2019 - sử dụng khi bàn giao
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=

# Website
WEB_HOST=127.0.0.1
WEB_PORT=8001

# PLC - chưa xác nhận thông số
PLC_PROTOCOL=
PLC_HOST=
PLC_PORT=
PLC_POLL_INTERVAL_SECONDS=1